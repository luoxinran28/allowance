
# ========================================
# Frontend Configuration
# ========================================

# API Configuration
# Local development URLs
NEXT_PUBLIC_API_URL=https://kwongfu.com/api
NEXT_PUBLIC_FRONTEND_URL=https://kwongfu.com

# API Secret (for Nonce generation - must match backend JWT_SECRET)
# This is used to generate cryptographic signatures for API requests
# Development value (must be at least 32 characters):
# Note: UPID and tier are fetched dynamically from API based on user's license
NEXT_PUBLIC_API_SECRET=

# ========================================
# Backend Configuration
# ========================================

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=4040

# Database
DATABASE_URL=postgres://postgres:allow_Me2Pa3s@postgres:5432/allowance

# JWT Configuration
JWT_SECRET=
ENCRYPTION_KEY=
JWT_EXPIRATION_HOURS=24
REFRESH_TOKEN_EXPIRATION_DAYS=7

# Token Expiration
ACTIVATION_TOKEN_EXPIRATION_HOURS=24
PASSWORD_RESET_TOKEN_EXPIRATION_HOURS=1

# ========================================
# Database Configuration
# ========================================

# Database Configuration
# Copy this file to .env and fill in your actual values

# Database Name (maps to POSTGRES_DB)
POSTGRES_DB=allowance

# Database User (maps to POSTGRES_USER)
POSTGRES_USER=postgres

# Database Password (maps to POSTGRES_PASSWORD)
POSTGRES_PASSWORD=your_secure_password_here

# Database Port (default: 5432)
DB_PORT=5432

# Database Host (for client connections)
DB_HOST=localhost

# ========================================
# pgAdmin Configuration
# ========================================

# pgAdmin Default Admin Email
PGADMIN_DEFAULT_EMAIL=

# pgAdmin Default Admin Password (CHANGE THIS!)
PGADMIN_DEFAULT_PASSWORD=

# pgAdmin Server Mode (set to False for single user)
PGADMIN_CONFIG_SERVER_MODE=False