# API Configuration
# Local development URLs
NEXT_PUBLIC_API_URL=http://localhost:4040
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3030

# UPID (Unique Product Identifier) Configuration
# Format: UPID + 12-character code (16 chars total)
# Available UPIDs:
#   - UPIDFORM0001 (Form Builder)
#   - UPIDSURVEY0001 (Survey Builder)
#   - UPIDDOC000001 (Document Generator)
#   - UPIDANALYTIC (Business Analytics)
#   - UPIDCRM000001 (Customer Relationship Manager)
# Default to the main Allowance product
NEXT_PUBLIC_PRODUCT_UPID=UPIDFORM0001
NEXT_PUBLIC_PRODUCT_TIER=free

# API Secret (for Nonce generation - must match backend JWT_SECRET)
# This is used to generate cryptographic signatures for API requests
# Development value (must be at least 32 characters):
NEXT_PUBLIC_API_SECRET=50f63a0a9cd856c0ca06dcdd839a45e7983888a8fedc1e703dddc8865464aab6
