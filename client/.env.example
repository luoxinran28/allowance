# API Configuration
# Production deployment URLs (browser-accessible)
# IMPORTANT: NEXT_PUBLIC_* variables are embedded at BUILD TIME
# The browser needs to access these URLs, so use public addresses
NEXT_PUBLIC_API_URL=http://47.79.78.229/api
NEXT_PUBLIC_FRONTEND_URL=http://47.79.78.229

# For local development, use:
# NEXT_PUBLIC_API_URL=http://localhost:4040
# NEXT_PUBLIC_FRONTEND_URL=http://localhost:3030

# API Secret (for Nonce generation - must match backend JWT_SECRET)
# This is used to generate cryptographic signatures for API requests
# Development value (must be at least 32 characters):
# Note: UPID and tier are fetched dynamically from API based on user's license
NEXT_PUBLIC_API_SECRET=50f63a0a9cd856c0ca06dcdd839a45e7983888a8fedc1e703dddc8865464aab6
