# .env.example

# Server Configuration
SERVER_HOST=127.0.0.1
SERVER_PORT=4040

# Database
DATABASE_URL=postgres://postgres:your_password_here@localhost:5432/allowance

# JWT Configuration
JWT_SECRET=your-secret-key-must-be-at-least-32-characters-long
JWT_EXPIRATION_HOURS=24
REFRESH_TOKEN_EXPIRATION_DAYS=7

# API Secret Key (required for encryption/signing)
API_SECRET=50f63a0a9cd856c0ca06dcdd839a45e7983888a8fedc1e703dddc8865464aab6

# Email Configuration (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@allowance.com

# Frontend URL
FRONTEND_URL=http://localhost:3030

# Token Expiration
ACTIVATION_TOKEN_EXPIRATION_HOURS=24
PASSWORD_RESET_TOKEN_EXPIRATION_HOURS=1
