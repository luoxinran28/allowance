# =============================================================================
# Allowance Server - Production Environment (47.82.64.35)
# =============================================================================
# Copy this file to .env on the production server

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=4040

# Database (Docker internal network)
DATABASE_URL=postgres://postgres:${POSTGRES_PASSWORD}@postgres:5432/allowance

# JWT Configuration
# CRITICAL: This secret MUST be shared with KwongFu for cross-service auth
JWT_SECRET=your-production-jwt-secret-must-be-at-least-32-characters-long-change-this
JWT_EXPIRATION_HOURS=24
REFRESH_TOKEN_EXPIRATION_DAYS=7

# API Secret Key (for request signing/nonce verification)
API_SECRET=your-production-api-secret-64-hex-chars-change-this-to-random-value

# Email Configuration (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@allowance.com

# Frontend URL (Allowance client on same server)
FRONTEND_URL=http://47.82.64.35:3030

# CORS: Allow KwongFu frontend to make requests
# Comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS=http://47.82.64.35:3030,http://47.79.78.229:3060,http://47.79.78.229

# Token Expiration
ACTIVATION_TOKEN_EXPIRATION_HOURS=24
PASSWORD_RESET_TOKEN_EXPIRATION_HOURS=1
